GEMINI_API_KEY=your-gemini-key-here
# Optional: override the default vision model (default: gemini-2.5-flash)
# GEMINI_MODEL=gemini-2.5-flash

# PostgreSQL connection string for furniture_catalog (Task 3).
# Provision via `vercel integration add neon`, then copy from .env.local.
DATABASE_URL=postgresql://user:password@host/dbname?sslmode=require
